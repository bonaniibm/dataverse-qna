<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>dvqna</AssemblyName>
    <RootNamespace>DvQna.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DvQna.Agent\DvQna.Agent.csproj" />
    <ProjectReference Include="..\DvQna.Auth\DvQna.Auth.csproj" />
    <ProjectReference Include="..\DvQna.Connectors\DvQna.Connectors.csproj" />
    <ProjectReference Include="..\DvQna.Tools\DvQna.Tools.csproj" />
    <ProjectReference Include="..\DvQna.Storage\DvQna.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
